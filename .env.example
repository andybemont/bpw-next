# Contact form (Resend + Cloudflare Turnstile)
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL="Bemont Photo <hello@bemontphoto.com>"

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Typography exploration — a | b | c (requires rebuild)
# a: Fraunces + Source Sans 3 (default)
# b: Manrope + IBM Plex Sans
# c: Newsreader + IBM Plex Sans
NEXT_PUBLIC_FONT_SYSTEM=a
